{
    "name": "webplayer-mcp-ui",
    "displayName": "TIDAL WebPlayer MCP UI",
    "description": "Interactive MCP App UI for TIDAL WebPlayer control in VS Code",
    "version": "1.0.1",
    "publisher": "alde-project",
    "repository": {
        "type": "git",
        "url": "https://github.com/alde-project/webplayer-mcp-ui"
    },
    "engines": {
        "vscode": "^1.99.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "mcpServerDefinitionProviders": [
            {
                "id": "webplayer-mcp-ui.webplayer-mcp",
                "label": "WebPlayer MCP"
            }
        ],
        "commands": [
            {
                "command": "webplayer.openUI",
                "title": "TIDAL WebPlayer: Open MCP App UI",
                "icon": "$(play)"
            },
            {
                "command": "webplayer.refreshUI",
                "title": "TIDAL WebPlayer: Refresh MCP App UI",
                "icon": "$(refresh)"
            },
            {
                "command": "webplayer.playNext",
                "title": "TIDAL WebPlayer: Play Next Track",
                "icon": "$(chevron-right)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "webplayerMcpContainer",
                    "title": "WebPlayer MCP",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "webplayerMcpContainer": [
                {
                    "type": "webview",
                    "id": "webplayerMcpView",
                    "name": "TIDAL WebPlayer",
                    "icon": "$(play)"
                }
            ]
        },
        "configuration": {
            "title": "TIDAL WebPlayer MCP",
            "properties": {
                "webplayerMcp.endpoint": {
                    "type": "string",
                    "default": "http://192.168.0.47:8766/mcp",
                    "description": "HTTP endpoint URL for the WebPlayer MCP server."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/vscode": "^1.99.0",
        "typescript": "^5.3.0"
    }
}
