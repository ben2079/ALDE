[Unit]
Description=Standalone WebPlayer MCP Server (TCP localhost)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Vs_Code_Projects/Projects/ALDE_Projekt
Environment=PYTHONPATH=%h/Vs_Code_Projects/Projects/ALDE_Projekt/ALDE
EnvironmentFile=-%h/.config/systemd/user/webplayer_mcp.env
ExecStart=/usr/bin/python3 -m alde.webplayer_mcp_server --transport tcp --host 127.0.0.1 --port 8765
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
