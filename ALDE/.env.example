# Minimal chat runtime configuration
# Do not commit real secrets.

# Required: API key for your OpenAI-compatible endpoint
# OPENAI_API_KEY=your_api_key_here

# Required: explicit chat model (no code default fallback)
# AI_IDE_CHAT_MODEL=your_model_name_here

# Optional: custom OpenAI-compatible base URL
# OPENAI_BASE_URL=https://your-endpoint.example/v1
